---
/**
 * <Header>: sticky top bar with name, main navigation and theme toggle.
 * Nav items come from `site.nav` in src/config/site.ts.
 *
 * Phones (< 40rem): two rows: name + toggle, then the nav as three equal
 * cells. Wider: a single row.
 */
import { site } from '@/config/site';
import { getPosts } from '@/lib/content';
import { href, isActive } from '@/lib/url';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const hasPosts = (await getPosts()).length > 0;
const nav = site.nav.filter((item) => item.hideIfEmpty !== 'writing' || hasPosts);
---

<header class="header" data-print="hide">
  <div class="container bar">
    <a href={href('/')} class="name" aria-current={isActive(path, '/') ? 'page' : undefined}>
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              class="label"
              href={href(item.path)}
              aria-current={isActive(path, item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: var(--rule);
    /* Behind the notch / status bar when the page scrolls under it. */
    padding-top: env(safe-area-inset-top);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-h);
  }
  .name {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    list-style: none;
    padding: 0;
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding-inline: var(--space-3);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  nav a:active {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  @media (hover: hover) {
    nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }
  }

  @media (max-width: 40rem) {
    .bar {
      grid-template-columns: 1fr auto;
      gap: 0 var(--space-4);
      padding-top: var(--space-1);
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      /* Full-bleed ruled strip across the screen. */
      margin-left: calc(-1 * var(--gutter-left));
      margin-right: calc(-1 * var(--gutter-right));
      border-top: var(--rule);
    }
    ul {
      display: grid;
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
    }
    li + li {
      border-left: var(--rule);
    }
  }
</style>
