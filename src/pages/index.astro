---
/**
 * Home page. Plain and short on purpose:
 *   Hello            site.greeting + site.intro (src/config/site.ts)
 *   Now              src/data/now.yaml (items with home: true)
 *   Story            featured projects with a `theme` (src/content/projects/),
 *                    introduced by site.storyIntro
 *   Notes            latest notes, hidden until there are any
 *   Not working      links to Music and Coffee
 *   Questions        src/data/faq.yaml (items with home: true)
 */
import EntryList from '@/components/EntryList.astro';
import StoryChapter from '@/components/StoryChapter.astro';
import EntryRow from '@/components/EntryRow.astro';
import LineDrawing from '@/components/LineDrawing.astro';
import Section from '@/components/Section.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaq, getFeaturedProjects, getMusic, getNow, getPosts } from '@/lib/content';
import { formatDate } from '@/lib/dates';
import { href } from '@/lib/url';

const now = (await getNow()).filter((n) => n.data.home);
// Story chapters: featured projects that have a `theme`, in their `order`.
const story = (await getFeaturedProjects()).filter((p) => p.data.theme);
const posts = (await getPosts()).slice(0, 3);
const artists = (await getMusic()).map((m) => m.data.artist);
const questions = (await getFaq()).filter((q) => q.data.home);
---

<BaseLayout>
  <section class="hello" aria-labelledby="hello-h">
    <p class="label muted">{site.location}</p>
    <h1 id="hello-h">{site.greeting}</h1>
    <div class="intro">
      {site.intro.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <ul class="links label">
      <li>
        <a href={href('/work/')}>Work →</a>
      </li>
      <li>
        <a href={href('/resume/')}>CV →</a>
      </li>
      {site.socials.map((s) => (
        <li>
          <a href={s.url} rel="me noopener">
            {s.label} ↗
          </a>
        </li>
      ))}
    </ul>
  </section>

  {now.length > 0 && (
    <Section title="What I'm up to" id="now">
      <a slot="action" href={href('/now/')}>
        More →
      </a>
      <dl class="now">
        {now.map(({ data }) => (
          <div>
            <dt class="label">{data.label}</dt>
            <dd>{data.text}</dd>
          </div>
        ))}
      </dl>
    </Section>
  )}

  {story.length > 0 && (
    <Section title="Things I've worked on" id="work">
      <a slot="action" href={href('/work/')}>
        See all →
      </a>
      <p class="lead-in">{site.storyIntro}</p>
      <div class="story">
        {story.map((p, i) => (
          <StoryChapter project={p} index={i + 1} />
        ))}
      </div>
    </Section>
  )}

  {posts.length > 0 && (
    <Section title="Notes" id="notes">
      <a slot="action" href={href('/notes/')}>
        All notes →
      </a>
      <EntryList>
        {posts.map((p) => (
          <EntryRow
            href={href(`/notes/${p.id}/`)}
            meta={formatDate(p.data.date)}
            title={p.data.title}
            description={p.data.description}
          />
        ))}
      </EntryList>
    </Section>
  )}

  <Section title="When I'm not working" id="off">
    <div class="tiles">
      <a class="tile" href={href('/music/')}>
        <span class="drawing">
          <LineDrawing kind="record" />
        </span>
        <span>
          <span class="tile-title">Music</span>
          <span class="muted">{artists.join(', ')}.</span>
        </span>
      </a>
      <a class="tile" href={href('/coffee/')}>
        <span class="drawing">
          <LineDrawing kind="v60" />
        </span>
        <span>
          <span class="tile-title">Coffee</span>
          <span class="muted">V60 pour-overs, a bit of research, and a patent. Yes, really.</span>
        </span>
      </a>
    </div>
  </Section>

  {questions.length > 0 && (
    <Section title="Stuff people ask me" id="faq">
      <a slot="action" href={href('/faq/')}>
        See all →
      </a>
      <dl class="qa">
        {questions.map(({ id, data }) => (
          <div>
            <dt>
              <a href={href(`/faq/#${id}`)}>{data.question}</a>
            </dt>
            <dd class="muted">{data.answer.split(/\n\s*\n/)[0]}</dd>
          </div>
        ))}
      </dl>
    </Section>
  )}
</BaseLayout>

<style>
  .hello {
    padding-block: var(--space-16) var(--space-8);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }
  .intro {
    margin-top: var(--space-6);
    max-width: 44rem;
    font-size: var(--text-md);
  }
  .intro p + p {
    margin-top: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin-top: var(--space-8);
    list-style: none;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .now {
    border-top: var(--rule);
  }

  .lead-in {
    max-width: 44rem;
    margin-bottom: var(--space-8);
    font-size: var(--text-md);
  }
  .now div {
    display: grid;
    grid-template-columns: var(--meta-col) minmax(0, 1fr);
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--rule);
  }
  @media (max-width: 40rem) {
    .now div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
  }
  .tile {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6);
    border: var(--rule);
    text-decoration: none;
  }
  .tile-title {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tile:active {
    background: var(--color-fg);
    color: var(--color-bg);
    --color-muted: var(--color-bg);
  }
  @media (hover: hover) {
    .tile:hover {
      background: var(--color-fg);
      color: var(--color-bg);
      --color-muted: var(--color-bg);
    }
  }

  .qa {
    border-top: var(--rule);
  }
  .qa div {
    padding-block: var(--space-4);
    border-bottom: var(--rule);
  }
  .qa dt a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  .qa dd {
    max-width: 62ch;
  }
</style>
