---
/** /now/: what I'm up to. Text: src/content/pages/now.mdx. Items: src/data/now.yaml. */
import ListBlock from '@/components/ListBlock.astro';
import SimplePage from '@/layouts/SimplePage.astro';
import { getNow, getPage } from '@/lib/content';

const page = await getPage('now');
const items = await getNow();
---

<SimplePage {page}>
  <ListBlock>
    {items.map(({ data }) => (
      <div class="kv">
        <span>{data.label}</span>
        <span>{data.text}</span>
      </div>
    ))}
  </ListBlock>
</SimplePage>
