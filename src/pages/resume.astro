---
/**
 * /resume/: résumé built entirely from your content files, so it never
 * drifts out of sync with the rest of the site.
 *
 * "Download PDF" opens the browser's print dialog; src/styles/print.css
 * strips the site chrome so "Save as PDF" gives a clean one-to-two page CV.
 */
import ExperienceItem from '@/components/ExperienceItem.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import Section from '@/components/Section.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getEducation,
  getExperience,
  getFeaturedProjects,
  getPublications,
  getSkills,
} from '@/lib/content';
import { formatRange } from '@/lib/dates';
import { href, prettyUrl } from '@/lib/url';

const [jobs, education, papers, skills, projects] = await Promise.all([
  getExperience(),
  getEducation(),
  getPublications(),
  getSkills(),
  getFeaturedProjects(),
]);

const contact = [
  { label: site.email, url: `mailto:${site.email}` },
  ...site.socials.map((s) => ({ label: prettyUrl(s.url), url: s.url })),
];

let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<BaseLayout title="Résumé" description={`Résumé of ${site.name}, ${site.role}.`}>
  <header class="top">
    <div>
      <h1>{site.name}</h1>
      <p class="role">
        {site.role} · {site.location}
      </p>
    </div>
    <button class="print label" type="button" data-print="hide" data-print-button>
      Download PDF
    </button>
  </header>

  <ul class="contact label">
    {contact.map((c) => (
      <li>
        <a href={c.url}>{c.label}</a>
      </li>
    ))}
  </ul>

  {jobs.length > 0 && (
    <Section index={next()} title="Experience">
      <ul class="plain">
        {jobs.map((j) => (
          <ExperienceItem job={j.data} variant="full" />
        ))}
      </ul>
    </Section>
  )}

  {projects.length > 0 && (
    <Section index={next()} title="Selected projects">
      <ul class="plain">
        {projects.map((p) => (
          <li class="item">
            <span class="label">{p.data.date.getUTCFullYear()}</span>
            <div>
              <h3>
                <a href={href(`/projects/${p.id}/`)}>{p.data.title}</a>
              </h3>
              <p class="muted">{p.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {papers.length > 0 && (
    <Section index={next()} title="Publications">
      <ul class="plain">
        {papers.map((p) => (
          <PublicationItem paper={p.data} />
        ))}
      </ul>
    </Section>
  )}

  {education.length > 0 && (
    <Section index={next()} title="Education">
      <ul class="plain">
        {education.map(({ data }) => (
          <li class="item">
            <span class="label">{formatRange(data.start, data.end)}</span>
            <div>
              <h3>
                {data.degree}, {data.institution}
              </h3>
              {data.notes.map((note) => (
                <p class="muted">{note}</p>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {skills.length > 0 && (
    <Section index={next()} title="Skills">
      <dl class="skills">
        {skills.map(({ data }) => (
          <div>
            <dt class="label">{data.label}</dt>
            <dd>{data.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </Section>
  )}
</BaseLayout>

<script>
  document.querySelector('[data-print-button]')?.addEventListener('click', () => window.print());
</script>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    padding-top: var(--space-16);
  }
  h1 {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }
  .role {
    margin-top: var(--space-3);
    font-size: var(--text-md);
  }
  .print {
    flex-shrink: 0;
    background: var(--color-fg);
    color: var(--color-bg);
    border: var(--rule);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  .print:hover {
    background: var(--color-bg);
    color: var(--color-fg);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
    padding-block: var(--space-3);
    border-block: var(--rule);
    list-style: none;
    padding-inline: 0;
    text-transform: none;
    letter-spacing: 0;
  }
  .plain {
    list-style: none;
    padding: 0;
    border-top: var(--rule);
  }
  .item {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--rule);
  }
  .item h3 {
    font-size: var(--text-md);
    font-weight: 600;
  }
  .item p {
    margin-top: var(--space-1);
  }
  .skills {
    border-top: var(--rule);
  }
  .skills div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--rule);
  }
  @media (max-width: 40rem) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
    .item,
    .skills div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  /* Tighter spacing on paper. */
  @media print {
    .top {
      padding-top: 0;
    }
    .item,
    .skills div {
      padding-block: 0.4rem;
    }
  }
</style>
